# Backend
DATABASE_URL=sqlite:///./dev.db
APP_SECRET_KEY=replace-with-a-long-random-secret
APP_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Bootstrap superadmin (development defaults shown; change in production)
SUPERADMIN_EMAIL=superadmin@gmail.com
SUPERADMIN_PASSWORD=replace-with-a-strong-password

# Email delivery for verification and password reset links
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SokoLnk
SMTP_USE_TLS=true

# Optional payment providers
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# Frontend (copy to frontend/.env)
VITE_API_BASE=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
