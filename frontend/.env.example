# Soko-Link Digital Marketplace — Frontend Environment Configuration
# Copy this file to .env or .env.local for local customization.

# Primary Backend API Base URL
# Local FastAPI backend default: http://localhost:8000
# Production Render backend default: https://sales-backend.onrender.com
VITE_API_BASE=http://localhost:8000

# Soko-Link AI Agent Service Base URL (Optional)
VITE_AGENT_API_BASE=http://localhost:8001

# Supabase Authentication Configuration (Optional - falls back to native JWT)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Platform Brand & Environment
VITE_APP_NAME=Soko-Link
VITE_APP_ENV=development
